# Copy this file to ".env" and change the values if needed.
# AWS keys are NOT stored here: boto3 reads them from "aws configure".

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# Governance: AI features pause when today's AI spending reaches this many US dollars
DAILY_BUDGET_USD=0.50
